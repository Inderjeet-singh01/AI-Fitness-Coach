# AI Fitness Coach — Backend Environment Variables
# Copy this file to `.env` in the project root and fill in your own values.
# Never commit the real `.env` file to version control.

# --- Groq LLM (required) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ROUTER_MODEL=openai/gpt-oss-20b

# --- Optional third-party tools ---
# Used by the gym-finder tool for location search (https://serper.dev/)
SERPER_API_KEY=your_serper_api_key
# Used by the gym-finder tool for geocoding (https://www.geoapify.com/)
GEOAPIFY_API_KEY=your_geoapify_api_key

# --- LLM output/latency tuning (optional, sensible defaults provided) ---
# MAX_OUTPUT_TOKENS=700
# ROUTER_MAX_OUTPUT_TOKENS=700
# GENERAL_MAX_OUTPUT_TOKENS=450
# GYM_MAX_OUTPUT_TOKENS=450
# TEMPERATURE=0.2

# gpt-oss reasoning effort (low|medium|high; empty = provider default).
# Hidden reasoning counts against the max tokens above.
# REASONING_EFFORT=low

# --- Planner/executor loop guards (optional, sensible defaults provided) ---
# MAX_REPLANS=3
# MAX_EXECUTION_STEPS=20
# Retries per task per turn (a task that fails for the same reason twice stops earlier)
# MAX_TASK_RETRIES=2
# Per-turn LLM budget; the turn stops cleanly when reached
# MAX_LLM_CALLS_PER_TURN=20
# MAX_LLM_TOKENS_PER_TURN=30000
# Groq SDK retries per call on 429 (honours retry-after); then the turn stops as rate_limited
# LLM_MAX_RETRIES=2
